# ─── Application ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://workmanager.example.com
NODE_ENV=production

# CSRF Protection — comma-separated additional allowed origins
CSRF_TRUSTED_ORIGINS=

# Database
DB_NAME=workmanagement
DB_USER=wmuser
DB_PASSWORD=change-me-to-a-secure-password

# Redis
REDIS_URL=redis://redis:6379
REDIS_PREFIX=wm:prod:

# Auth (Better Auth)
AUTH_SECRET=change-me-to-a-random-string
AUTH_URL=https://workmanager.example.com

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft OAuth
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=

# Storage (MinIO)
MINIO_ACCESS_KEY=change-me-to-secure-key
MINIO_SECRET_KEY=change-me-to-secure-secret
S3_BUCKET=workmanagement-files

# Search
MEILI_MASTER_KEY=change-me-to-secure-key

# Email (Resend — production)
# Sign up at https://resend.com for an API key, then verify your sending
# domain (SPF + DKIM) at https://resend.com/domains
RESEND_API_KEY=
EMAIL_FROM=noreply@workmanager.com
EMAIL_FROM_NAME=WorkManager
EMAIL_UNSUBSCRIBE_URL=https://app.workmanager.com/settings/notifications

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
